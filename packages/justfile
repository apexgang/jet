set working-directory := "."
set positional-arguments

rust_min_stack := "8388608" # 8 MiB

help:
	just -l

jet *args:
	cargo run --bin jet -- {{ args }}

fmt:
	cargo fmt --all

fix *args:
	cargo clippy --fix --tests --allow-dirty {{ args }}

clippy *args:
	cargo clippy --tests {{ args }}

# Scan all repository Rust sources, including tests, and fail on findings.
# Use a fresh database path; optionally pin the query pack to a GitHub scan.
codeql-scan database output cli="codeql" query_pack="codeql/rust-queries":
	"$3" database create "$1" --language=rust --build-mode=none --source-root=.. --threads=4
	"$3" database analyze "$1" "$4" --download --format=sarif-latest --output="$2" --threads=4
	python3 -c 'import json, sys; count = sum(len(run.get("results", [])) for run in json.load(open(sys.argv[1]))["runs"]); print(f"CodeQL findings: {count}"); sys.exit(count > 0)' "$2"

crate name *args:
	cargo new {{ name }} {{ args }}

[unix]
install:
	rustup show active-toolchain
	cargo fetch

[unix]
test *args: build-run-helper
	RUST_MIN_STACK={{ rust_min_stack }} cargo test --no-fail-fast "$@"

# Subprocess conformance uses the separately deployed helper and Crafts.
build-run-helper:
	cargo build -p jet-fueld -p jet-craft-claude -p jet-craft-codex

# List tests without running them; accepts Cargo package and target arguments.
[unix]
test-list *args:
	RUST_MIN_STACK={{ rust_min_stack }} cargo test "$@" -- --list

# Run only doctests; `just test` also includes them by default.
[unix]
test-doc *args:
	RUST_MIN_STACK={{ rust_min_stack }} cargo test --doc --no-fail-fast "$@"

bench *args:
	cargo bench --workspace --bench '*' {{ args }}

bench-smoke:
	just bench -- --test

check:
	cargo check

# Run alone on the fixed macOS/Linux reference host; includes a five-minute window.
resource-test:
	just test -p jet-fueld --test replay -- --nocapture
	just test -p jet-daemon --test recovery -- --nocapture
	just test -p jet-daemon --bin jetd idle_craft -- --nocapture
	just test -p jet-daemon --test resources -- --include-ignored --nocapture

# Regenerate every wire schema and its GUI models from the Rust wire DTOs.
contracts: (emit-contracts justfile_directory() / "..")

# Emit the contracts under one root, laid out exactly as they are committed.
[private]
emit-contracts root:
	#!/usr/bin/env bash
	set -euo pipefail
	contracts="{{ root }}/packages/jet-protocol/contracts"
	typescript="{{ root }}/apps/jet-tauri/src/lib/protocol"
	swift="{{ root }}/apps/jet/jet/Protocol"
	mkdir -p "$contracts" "$typescript" "$swift"
	cargo run -q -p jet-protocol --features schema --example craft-schema > "$contracts/craft-v1.schema.json"
	cargo run -q -p jet-protocol --features schema --example jet-schema > "$contracts/jet-v1.schema.json"
	cargo run -q -p jet-protocol --features schema --example remote-tool-schema > "$contracts/remote-tool.schema.json"
	# Craft models serve the contract test; only clients need the Jet models.
	python3 ../scripts/wire-models.py "$contracts/craft-v1.schema.json" "$contracts/CraftModels.ts" "$contracts/CraftModels.swift"
	python3 ../scripts/wire-models.py "$contracts/jet-v1.schema.json" "$typescript/JetModels.ts" "$swift/JetModels.swift"

# Fail when a committed contract no longer matches the Rust wire DTOs.
contracts-check:
	#!/usr/bin/env bash
	set -euo pipefail
	scratch="$(mktemp -d)"
	trap 'rm -rf "$scratch"' EXIT
	root="$(cd .. && pwd)"
	just emit-contracts "$scratch"
	( cd "$scratch" && find . -type f -print0 ) | while IFS= read -r -d '' artifact; do
		diff -u "$root/$artifact" "$scratch/$artifact"
	done

# Validate the shared corpora in both GUI languages; Node 24+ and Swift required.
contracts-test node_bin="node":
	#!/usr/bin/env bash
	set -euo pipefail
	scratch="$(mktemp -d)"
	trap 'rm -rf "$scratch"' EXIT
	"$1" jet-protocol/contracts/tests/craft-fixtures.ts
	"$1" jet-protocol/contracts/tests/jet-fixtures.ts
	swiftc -module-cache-path "$scratch/cache" jet-protocol/contracts/CraftModels.swift jet-protocol/contracts/tests/main.swift -o "$scratch/craft"
	"$scratch/craft" jet-protocol/contracts/craft-v1.schema.json jet-protocol/contracts/craft-fixtures.json
	swiftc -module-cache-path "$scratch/cache" ../apps/jet/jet/Protocol/JetModels.swift jet-protocol/contracts/tests/main.swift -o "$scratch/jet"
	"$scratch/jet" jet-protocol/contracts/jet-v1.schema.json jet-protocol/contracts/jet-fixtures.json

build:
	cargo build

build-release:
	cargo build --release

clean:
	cargo clean

# Create a forward-only timestamped migration in jet-store.
sqlx-migrate-add name: && sqlx-migrations-check
	# ASVS 1.2.5: pass the name as one argument, never as shell source.
	cd jet-store && sqlx migrate add --source ./migrations --timestamp --simple -- "$1"

# Check migration conventions without building or opening a database.
sqlx-migrations-check:
	#!/usr/bin/env bash
	set -euo pipefail
	cd jet-store
	duplicates="$(printf '%s\n' migrations/*.sql | sed 's|.*/||; s/_.*//' | sort | uniq -d)"
	if [[ -n "$duplicates" ]]; then
		printf 'Duplicate migration versions:\n%s\n' "$duplicates" >&2
		exit 1
	fi
	for migration in migrations/*.sql; do
		case "$migration" in
			*.up.sql|*.down.sql)
				printf 'Use a simple forward-only .sql migration: %s\n' "$migration" >&2
				exit 1
				;;
		esac
	done
	# Nontransactional migrations can leave the store half-migrated on failure.
	if grep -n '^-- no-transaction' migrations/*.sql; then
		echo 'Migrations must run inside a transaction.' >&2
		exit 1
	fi

# Regenerate the committed compile-time query cache in jet-store/.sqlx.
sqlx-prepare: sqlx-migrations-check
	#!/usr/bin/env bash
	set -euo pipefail
	scratch="$(mktemp -d)"
	trap 'rm -rf "$scratch"' EXIT
	export DATABASE_URL="sqlite://$scratch/prepare.sqlite3?mode=rwc"
	cd jet-store
	sqlx migrate run --source ./migrations
	cargo sqlx prepare -- --lib --tests

# Fail when jet-store/.sqlx no longer matches the migrations and the queries.
sqlx-check: sqlx-migrations-check
	#!/usr/bin/env bash
	set -euo pipefail
	scratch="$(mktemp -d)"
	trap 'rm -rf "$scratch"' EXIT
	export DATABASE_URL="sqlite://$scratch/prepare.sqlite3?mode=rwc"
	cd jet-store
	sqlx migrate run --source ./migrations
	cargo sqlx prepare --check -- --lib --tests
