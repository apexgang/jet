set working-directory := "."
set positional-arguments

rust_min_stack := "8388608" # 8 MiB

help:
	just -l

# `jet-dev`
jet *args:
	cargo run --bin jet -- {{ args }}

fmt:
	cargo fmt --all

fix *args:
	cargo clippy --fix --tests --allow-dirty {{ args }}

clippy *args:
	cargo clippy --tests {{ args }}

crate name *args:
	cargo new {{ name }} {{ args }}

[unix]
install:
	rustup show active-toolchain
	cargo fetch

[unix]
test *args:
	RUST_MIN_STACK={{ rust_min_stack }} cargo test --no-fail-fast {{ args }}

bench *args:
	cargo bench --workspace --bench '*' {{ args }}

bench-smoke:
	just bench -- --test

check:
	cargo check

build:
	cargo build

build-release:
	cargo build --release

clean:
	cargo clean

# Regenerate the committed compile-time query cache in jet-store/.sqlx.
sqlx-prepare:
	#!/usr/bin/env bash
	set -euo pipefail
	scratch="$(mktemp -d)"
	trap 'rm -rf "$scratch"' EXIT
	export DATABASE_URL="sqlite://$scratch/prepare.sqlite3?mode=rwc"
	cd jet-store
	sqlx migrate run --source ./migrations
	cargo sqlx prepare -- --lib --tests

# Fail when jet-store/.sqlx no longer matches the migrations and the queries.
sqlx-check:
	#!/usr/bin/env bash
	set -euo pipefail
	scratch="$(mktemp -d)"
	trap 'rm -rf "$scratch"' EXIT
	export DATABASE_URL="sqlite://$scratch/prepare.sqlite3?mode=rwc"
	cd jet-store
	sqlx migrate run --source ./migrations
	cargo sqlx prepare --check -- --lib --tests
	# A version prefix used twice commits the first migration and wedges the
	# second, so refuse a set that carries one.
	test -z "$(ls migrations | cut -d_ -f1 | sort | uniq -d)"
	# A migration outside a transaction cannot roll back, so it can leave the
	# store half-migrated with no bookkeeping row.
	! grep -l '^-- no-transaction' migrations/*.sql
