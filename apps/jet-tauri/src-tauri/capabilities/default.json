{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-plane-setup",
  "description": "Plane status and preview-gated local setup operations for the main window",
  "windows": ["main"],
  "platforms": ["linux", "macOS"],
  "permissions": [
    "allow-open-plane-feed",
    "allow-load-setup",
    "allow-preview-project",
    "allow-register-project",
    "allow-preview-project-removal",
    "allow-remove-project",
    "allow-bind-harness-account",
    "allow-load-conversations",
    "allow-search-conversations",
    "allow-load-conversation",
    "allow-create-conversation",
    "allow-start-run",
    "allow-submit-turn",
    "dialog:allow-open"
  ]
}
