{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-plane-setup",
  "description": "Plane status, pairing, tasks, and preview-gated local setup operations for the main window. Settings mutations live in the settings-window capability.",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS"
  ],
  "permissions": [
    "allow-open-plane-feed",
    "allow-close-plane-feed",
    "allow-list-planes",
    "allow-load-plane-detail",
    "allow-load-pairing",
    "allow-set-pairing-gate",
    "allow-open-pairing-offer",
    "allow-confirm-pairing-request",
    "allow-prepare-paired-client-change",
    "allow-execute-paired-client-change",
    "allow-add-remote-plane",
    "allow-repair-remote-plane",
    "allow-claim-remote-pairing",
    "allow-complete-remote-pairing",
    "allow-cancel-remote-pairing",
    "allow-forget-remote-plane",
    "allow-load-setup",
    "allow-preview-project",
    "allow-register-project",
    "allow-preview-project-removal",
    "allow-remove-project",
    "allow-bind-harness-account",
    "allow-load-conversations",
    "allow-search-conversations",
    "allow-load-conversation",
    "allow-create-conversation",
    "allow-start-run",
    "allow-submit-turn",
    "allow-load-run-supervision",
    "allow-withdraw-turn",
    "allow-interrupt-turn",
    "allow-stop-run",
    "allow-authorize-approval-retry",
    "allow-load-work-panel",
    "allow-load-more-changes",
    "allow-load-patch-chunk",
    "allow-load-work-file",
    "allow-save-work-file",
    "allow-submit-file-review",
    "allow-open-workspace-terminal",
    "allow-close-workspace-terminal",
    "allow-attach-workspace-terminal",
    "allow-send-terminal-input",
    "allow-resize-workspace-terminal",
    "allow-detach-workspace-terminal",
    "dialog:allow-open",
    "allow-load-deliveries",
    "allow-prepare-delivery",
    "allow-execute-delivery",
    "allow-prepare-delivery-acknowledgement",
    "allow-open-settings",
    "allow-load-desktop-preferences"
  ]
}
