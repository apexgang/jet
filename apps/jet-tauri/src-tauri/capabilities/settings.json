{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "Device preferences, navigation, read-only Plane summaries, and reviewed Plane setting changes for the Settings window. It never receives Plane feeds or agent content, and grants no pairing, Plane, dialog, or window-core permission.",
  "windows": [
    "settings"
  ],
  "platforms": [
    "linux",
    "macOS"
  ],
  "permissions": [
    "allow-watch-settings-navigation",
    "allow-remember-settings-pane",
    "allow-close-settings",
    "allow-load-desktop-preferences",
    "allow-set-desktop-preferences",
    "allow-load-notification-settings",
    "allow-set-notification-settings",
    "allow-load-settings",
    "allow-prepare-setting-change",
    "allow-apply-settings-change",
    "allow-load-work-context",
    "allow-watch-settings-changes",
    "allow-list-planes",
    "allow-load-plane-detail"
  ]
}
