{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "Device preferences, navigation, read-only Plane summaries, and reviewed Plane setting, Account binding, Auto-continue, Craft and Harness extension changes for the Settings window. Local Craft files are chosen in a native dialog opened by the shell. It never receives Plane feeds or agent content, and grants no pairing, Plane, dialog, or window-core permission.",
  "windows": [
    "settings"
  ],
  "platforms": [
    "linux",
    "macOS"
  ],
  "permissions": [
    "allow-watch-settings-navigation",
    "allow-remember-settings-pane",
    "allow-close-settings",
    "allow-load-desktop-preferences",
    "allow-set-desktop-preferences",
    "allow-load-notification-settings",
    "allow-set-notification-settings",
    "allow-load-settings",
    "allow-prepare-setting-change",
    "allow-apply-settings-change",
    "allow-load-work-context",
    "allow-watch-settings-changes",
    "allow-load-agents",
    "allow-prepare-account-bind",
    "allow-load-account-detail",
    "allow-load-usage-history",
    "allow-prepare-auto-continue",
    "allow-prepare-account-unbind",
    "allow-prepare-craft-disable",
    "allow-pick-local-craft-source",
    "allow-discover-craft",
    "allow-load-extension-catalog",
    "allow-inspect-extension",
    "allow-prepare-extension-change",
    "allow-load-extension-change",
    "allow-list-planes",
    "allow-load-plane-detail"
  ]
}
